{
  "expo": {
    "name": "ZelaFix",
    "slug": "enzookuizumi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F8FAFC",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.fiap.zelafix"
    },
    "android": {
      "package": "br.com.fiap.zelafix",
      "versionCode": 15,
      "backgroundColor": "#F8FAFC",
      "adaptiveIcon": {
        "backgroundColor": "#064E3B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "O ZelaFix precisa acessar sua galeria para anexar fotos de ocorrências urbanas.",
          "cameraPermission": "O ZelaFix precisa acessar sua câmera para fotografar ocorrências urbanas.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O ZelaFix utiliza sua localização para preencher automaticamente o CEP e o endereço da ocorrência.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-secure-store",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#064E3B",
          "imageWidth": 200
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0343be50-386b-4241-be1e-89fd749cd4ae"
      }
    },
    "experiments": {
      "reactCompiler": true
    },
    "owner": "enzookuizumi06s-team"
  }
}
